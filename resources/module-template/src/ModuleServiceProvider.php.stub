<?php

namespace Perysee\Modules\{{Studly}};

use App\Modules\ModuleProvider;
use Illuminate\Http\Request;

class ModuleServiceProvider extends ModuleProvider
{
    public function boot(): void
    {
        // Routes are served under /modules/{{id}}, for signed-in users.
        $this->loadModuleRoutes(__DIR__.'/../routes.php');

        // Data for this module's screens, read in JavaScript as modules.data["{{id}}"].
        $this->shareData(fn (Request $request): array => ['message' => 'Hello from {{name}}.']);

        // Optional: add an entry to an existing navigation zone ("workspace" or "admin").
        // $this->addNavigation('admin', '{{name}}', 'i-tabler-puzzle', '{{id}}.index');

        // Optional: override the instance name, logo address and accent color.
        // $this->brand(fn (): array => ['name' => '{{name}}']);

        // Optional: react to a moment of the Core. The listener receives a read-only event with a payload of ids and
        // counters, runs only while this module is enabled, and its failures never reach the Core. This needs
        // "core": "0.4.0" or later in module.json, so that an older Perysee refuses to enable the module.
        // $this->listen(\App\Modules\Events\ModuleQuarantined::class, function (\App\Modules\Events\ModuleQuarantined $event): void {
        //     \Illuminate\Support\Facades\Log::info('Module quarantined: '.$event->moduleId);
        // });
    }
}
