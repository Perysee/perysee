{
  "version": 7,
  "colors": {
    "primary": "brand",
    "secondary": "brand",
    "success": "brand",
    "info": "brand",
    "warning": "brand",
    "error": "brand",
    "neutral": "custom-neutral"
  },
  "radius": 0,
  "font": {
    "sans": "Aspekta",
    "serif": "Aspekta"
  },
  "icons": "tabler",
  "palettes": {
    "custom-neutral": {
      "shades": {
        "50": "#FBFBFD",
        "100": "#F2F2F4",
        "200": "#E5E5E7",
        "300": "#CFCFD1",
        "400": "#A7A7A9",
        "500": "#818183",
        "600": "#646466",
        "700": "#49494B",
        "800": "#333335",
        "900": "#1D1D1F",
        "950": "#0E0E10"
      }
    },
    "brand": {
      "shades": {
        "50": "#F0F6FC",
        "100": "#E0EDF9",
        "200": "#BFD9F2",
        "300": "#8CBAE8",
        "400": "#4791DA",
        "500": "#0066CC",
        "600": "#0058AF",
        "700": "#004993",
        "800": "#003972",
        "900": "#002B56",
        "950": "#001D39"
      }
    }
  },
  "style": {
    "defaults": {
      "colors": {
        "inputs": "neutral"
      },
      "size": "default",
      "variants": {
        "buttons": "default",
        "panels": "soft"
      }
    },
    "tokens": {
      "light": {
        "--ui-primary": "#0066CC",
        "--ui-radius": "0",
        "--ui-bg": "#FBFBFD",
        "--ui-bg-inverted": "#1D1D1F",
        "--ui-border-inverted": "#1D1D1F",
        "--ui-surface": "var(--ui-bg-elevated)",
        "--ui-border-strong": "var(--ui-border-accented)",
        "color-scheme": "light",
        "--ui-text": "#1D1D1F",
        "--ui-text-dimmed": "#5E5E64",
        "--ui-text-muted": "#49494B",
        "--ui-text-toned": "#333335",
        "--ui-text-highlighted": "#1D1D1F",
        "--ui-text-inverted": "#FBFBFD",
        "--ui-bg-muted": "#F2F2F4",
        "--ui-bg-elevated": "#FFFFFF",
        "--ui-bg-accented": "#E8E8EB",
        "--ui-border": "#E5E5E7",
        "--ui-border-muted": "#EFEFF1",
        "--ui-border-accented": "#818183",
        "--brand-subtle": "#E6F0FA",
        "--brand-action": "#0066CC",
        "--brand-action-hover": "#0058AF",
        "--ui-success": "#1A6E44",
        "--ui-warning": "#8A5A00",
        "--ui-error": "#B42318",
        "--ui-bg-workspace": "var(--ui-bg-muted)",
        "--ui-bg-panel": "#FFFFFF",
        "--ui-bg-overlay": "#FFFFFF",
        "--brand-shadow-panel": "0 1px 2px rgb(29 29 31 / 0.04)",
        "--brand-shadow-overlay": "0 12px 40px rgb(29 29 31 / 0.10), 0 2px 8px rgb(29 29 31 / 0.04)"
      },
      "dark": {
        "--ui-primary": "#6CB4FF",
        "--ui-radius": "0",
        "--ui-bg": "#0E0E10",
        "--ui-bg-inverted": "#F5F5F7",
        "--ui-border-inverted": "#F5F5F7",
        "--ui-surface": "var(--ui-bg-elevated)",
        "--ui-border-strong": "var(--ui-border-accented)",
        "color-scheme": "dark",
        "--ui-text": "#F5F5F7",
        "--ui-text-dimmed": "#A1A1A8",
        "--ui-text-muted": "#C2C2C8",
        "--ui-text-toned": "#DCDCE1",
        "--ui-text-highlighted": "#F5F5F7",
        "--ui-text-inverted": "#0E0E10",
        "--ui-bg-muted": "#161618",
        "--ui-bg-elevated": "#1D1D1F",
        "--ui-bg-accented": "#2A2A2E",
        "--ui-border": "#2E2E33",
        "--ui-border-muted": "#232327",
        "--ui-border-accented": "#818183",
        "--brand-subtle": "#10253D",
        "--brand-action": "#0066CC",
        "--brand-action-hover": "#0058AF",
        "--ui-secondary": "#6CB4FF",
        "--ui-success": "#7FD4A3",
        "--ui-info": "#6CB4FF",
        "--ui-warning": "#E3B65C",
        "--ui-error": "#F08C84",
        "--ui-bg-workspace": "var(--ui-bg)",
        "--ui-bg-panel": "#161618",
        "--ui-bg-overlay": "#1D1D1F",
        "--brand-shadow-panel": "0 1px 2px rgb(0 0 0 / 0.24)",
        "--brand-shadow-overlay": "0 16px 48px rgb(0 0 0 / 0.5), 0 4px 12px rgb(0 0 0 / 0.3)"
      }
    }
  },
  "components": {
    "card": {
      "slots": {
        "root": "brand-panel ring-0"
      }
    },
    "button": {
      "compoundVariants": [
        {
          "color": [
            "primary",
            "secondary",
            "success",
            "info",
            "warning",
            "error"
          ],
          "variant": "solid",
          "class": "brand-solid"
        },
        {
          "color": "neutral",
          "variant": "outline",
          "class": "brand-control"
        }
      ]
    },
    "popover": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "dropdownMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "contextMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "selectMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "inputMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "modal": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "slideover": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "tooltip": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "select": {
      "slots": {
        "base": "brand-control",
        "content": "brand-overlay ring-0"
      }
    },
    "input": {
      "slots": {
        "base": "brand-control"
      }
    },
    "textarea": {
      "slots": {
        "base": "brand-control"
      }
    },
    "table": {
      "slots": {
        "root": "brand-table",
        "thead": "border-default"
      }
    }
  }
}
