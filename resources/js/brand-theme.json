{
  "version": 4,
  "colors": {
    "primary": "brand",
    "secondary": "brand",
    "success": "brand",
    "info": "brand",
    "warning": "brand",
    "error": "brand",
    "neutral": "custom-neutral"
  },
  "radius": 0,
  "font": {
    "sans": "Geist",
    "serif": "Geist"
  },
  "icons": "tabler",
  "palettes": {
    "custom-neutral": {
      "shades": {
        "50": "#F8F8F8",
        "100": "color-mix(in srgb, #00020C 3%, #F8F8F8)",
        "200": "color-mix(in srgb, #00020C 9%, #F8F8F8)",
        "300": "color-mix(in srgb, #00020C 18%, #F8F8F8)",
        "400": "color-mix(in srgb, #00020C 32%, #F8F8F8)",
        "500": "color-mix(in srgb, #00020C 48%, #F8F8F8)",
        "600": "color-mix(in srgb, #00020C 64%, #F8F8F8)",
        "700": "color-mix(in srgb, #00020C 76%, #F8F8F8)",
        "800": "color-mix(in srgb, #00020C 87%, #F8F8F8)",
        "900": "color-mix(in srgb, #00020C 94%, #F8F8F8)",
        "950": "#00020C"
      }
    },
    "brand": {
      "shades": {
        "50": "color-mix(in srgb, #5516FF 4%, #F8F8F8)",
        "100": "color-mix(in srgb, #5516FF 8%, #F8F8F8)",
        "200": "color-mix(in srgb, #5516FF 18%, #F8F8F8)",
        "300": "color-mix(in srgb, #5516FF 35%, #F8F8F8)",
        "400": "color-mix(in srgb, #5516FF 70%, #F8F8F8)",
        "500": "#5516FF",
        "600": "color-mix(in srgb, #5516FF 90%, #00020C)",
        "700": "color-mix(in srgb, #5516FF 75%, #00020C)",
        "800": "color-mix(in srgb, #5516FF 60%, #00020C)",
        "900": "color-mix(in srgb, #5516FF 45%, #00020C)",
        "950": "color-mix(in srgb, #5516FF 30%, #00020C)"
      }
    }
  },
  "style": {
    "defaults": {
      "colors": {
        "inputs": "neutral"
      },
      "size": "default",
      "variants": {
        "buttons": "default",
        "panels": "soft"
      }
    },
    "tokens": {
      "light": {
        "--ui-primary": "#5516FF",
        "--ui-radius": "0",
        "--ui-bg": "#F8F8F8",
        "--ui-bg-inverted": "#00020C",
        "--ui-border-inverted": "#00020C",
        "--ui-surface": "var(--ui-bg-elevated)",
        "--ui-border-strong": "var(--ui-border-accented)",
        "color-scheme": "light",
        "--ui-text": "#00020C",
        "--ui-text-dimmed": "#00020C",
        "--ui-text-muted": "#00020C",
        "--ui-text-toned": "#00020C",
        "--ui-text-highlighted": "#00020C",
        "--ui-text-inverted": "#F8F8F8",
        "--ui-bg-muted": "#F0F0F1",
        "--ui-bg-elevated": "#F8F8F8",
        "--ui-bg-accented": "#E7E7E9",
        "--ui-border": "color-mix(in srgb, #00020C 11%, #F8F8F8)",
        "--ui-border-muted": "color-mix(in srgb, #00020C 6%, #F8F8F8)",
        "--ui-border-accented": "#7D8597",
        "--brand-subtle": "color-mix(in srgb, #5516FF 8%, #F8F8F8)",
        "--brand-action": "#5516FF",
        "--brand-action-hover": "#4610DA",
        "--ui-bg-workspace": "var(--ui-bg-muted)",
        "--ui-bg-panel": "#F8F8F8",
        "--ui-bg-overlay": "#F8F8F8",
        "--brand-shadow-panel": "0 1px 2px rgb(0 2 12 / 0.035)",
        "--brand-shadow-overlay": "0 12px 40px rgb(0 2 12 / 0.10), 0 2px 8px rgb(0 2 12 / 0.04)"
      },
      "dark": {
        "--ui-primary": "#B4A0FF",
        "--ui-radius": "0",
        "--ui-bg": "#00020C",
        "--ui-bg-inverted": "#F8F8F8",
        "--ui-border-inverted": "#F8F8F8",
        "--ui-surface": "var(--ui-bg-elevated)",
        "--ui-border-strong": "var(--ui-border-accented)",
        "color-scheme": "dark",
        "--ui-text": "#F8F8F8",
        "--ui-text-dimmed": "#969CAE",
        "--ui-text-muted": "#B9BDCA",
        "--ui-text-toned": "#D9DCE5",
        "--ui-text-highlighted": "#F8F8F8",
        "--ui-text-inverted": "#00020C",
        "--ui-bg-muted": "#080A14",
        "--ui-bg-elevated": "#10121D",
        "--ui-bg-accented": "#1A1D2B",
        "--ui-border": "#292D3C",
        "--ui-border-muted": "#1C202D",
        "--ui-border-accented": "#737B90",
        "--brand-subtle": "#1C1535",
        "--brand-action": "#5516FF",
        "--brand-action-hover": "#4610DA",
        "--ui-secondary": "#B4A0FF",
        "--ui-success": "#B4A0FF",
        "--ui-info": "#B4A0FF",
        "--ui-warning": "#B4A0FF",
        "--ui-error": "#B4A0FF",
        "--ui-bg-workspace": "var(--ui-bg)",
        "--ui-bg-panel": "#080A14",
        "--ui-bg-overlay": "#10121D",
        "--brand-shadow-panel": "0 1px 2px rgb(0 2 12 / 0.18)",
        "--brand-shadow-overlay": "0 16px 48px rgb(0 2 12 / 0.45), 0 4px 12px rgb(0 2 12 / 0.25)"
      }
    }
  },
  "components": {
    "card": {
      "slots": {
        "root": "brand-panel ring-0"
      }
    },
    "button": {
      "compoundVariants": [
        {
          "color": [
            "primary",
            "secondary",
            "success",
            "info",
            "warning",
            "error"
          ],
          "variant": "solid",
          "class": "brand-solid"
        },
        {
          "color": "neutral",
          "variant": "outline",
          "class": "brand-control"
        }
      ]
    },
    "popover": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "dropdownMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "contextMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "selectMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "inputMenu": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "modal": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "slideover": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "tooltip": {
      "slots": {
        "content": "brand-overlay ring-0"
      }
    },
    "select": {
      "slots": {
        "base": "brand-control",
        "content": "brand-overlay ring-0"
      }
    },
    "input": {
      "slots": {
        "base": "brand-control"
      }
    },
    "textarea": {
      "slots": {
        "base": "brand-control"
      }
    },
    "table": {
      "slots": {
        "root": "brand-table",
        "thead": "border-default"
      }
    }
  }
}
