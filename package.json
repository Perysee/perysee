{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && npm run build:tracker",
    "dev": "vite",
    "build:tracker": "node scripts/build-tracker.mjs",
    "test:tracker": "node --test tests/Tracker/*.test.mjs",
    "test:distribution": "node --test tests/Distribution/*.test.mjs",
    "test:charts": "node --test tests/Charts/*.test.mjs",
    "test:security": "node --test tests/Security/*.test.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "laravel-vite-plugin": "^3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0"
  },
  "name": "@perysee/application",
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "@inertiajs/vue3": "^3.9.1",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "echarts": "^6.1.0",
    "vue": "^3.5.44"
  }
}
